# Public Supabase values — safe to ship to the browser. Access is enforced by Row Level Security,
# and every row is end-to-end encrypted before it leaves the device.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Shown in the privacy notice as the contact for data requests. Set this before going public.
VITE_CONTACT_EMAIL=privacy@example.com
